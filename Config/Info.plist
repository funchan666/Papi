<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Papi</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchCream</string>
		<key>UIImageName</key>
		<string>brandMark</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Photograph coffee moments or preview your camera before a video feature you choose to open.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record voice notes and sound for coffee videos you choose to create. Access is requested when you start recording or prepare a video feature.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>th</string>
		<string>ar</string>
		<string>vi</string>
		<string>ko</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Fonts/PapiCounter-Bold.ttf</string>
		<string>Fonts/PapiCounter-Regular.ttf</string>
		<string>Fonts/PapiCounter-SemiBold.ttf</string>
		<string>Fonts/PapiEditorial-Italic.ttf</string>
		<string>Fonts/PapiEditorial-Regular.ttf</string>
		<string>Fonts/PapiEditorial-SemiBold.ttf</string>
	</array>
</dict>
</plist>
